{
  "name": "grimorio-nahvvatzal",
  "productName": "O Amneritharion",
  "version": "2.0.0",
  "description": "O Tomo de Gionyyl",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "styles": "tailwindcss -i assets/css/tailwind-input.css -o assets/css/tailwind.css --minify",
    "build": "npm run styles && electron-builder --win nsis portable",
    "build:dir": "npm run styles && electron-builder --dir"
  },
  "build": {
    "appId": "com.abellathebeauty.grimorio",
    "files": [
      "index.html",
      "style.css",
      "script.js",
      "main.js",
      "preload.js",
      "js/**/*",
      "data/**/*",
      "img/**/*",
      "audio/**/*",
      "assets/**/*",
      "LICENSE.txt",
      "THIRD_PARTY_NOTICES.txt",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Desinstalar O Amneritharion",
      "license": "LICENSE.txt"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbellaTheBeauty/grim-rio-tipagem.git"
  },
  "keywords": [
    "grimorio",
    "nahvvatzal",
    "magia"
  ],
  "author": "Abella",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/quattrocento-sans": "^5.2.8",
    "@fortawesome/fontawesome-free": "^7.0.0",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^3.4.17"
  }
}
